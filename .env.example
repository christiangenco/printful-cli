# Printful API token — get from https://www.printful.com/dashboard/developer/api-tokens
PRINTFUL_API_TOKEN=

# Store ID (required for OAuth tokens) — find at https://www.printful.com/dashboard/store
PRINTFUL_STORE_ID=

# Default shipping address (used by `order` command)
PRINTFUL_SHIP_NAME=Christian Genco
PRINTFUL_SHIP_ADDRESS1=
PRINTFUL_SHIP_CITY=
PRINTFUL_SHIP_STATE=TX
PRINTFUL_SHIP_ZIP=
PRINTFUL_SHIP_COUNTRY=US
